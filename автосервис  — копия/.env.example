APP_SECRET=replace-with-at-least-32-random-characters
OWNER_PASSWORD=replace-with-strong-password-12-characters-minimum
APP_URL=http://127.0.0.1:3000
# Local only. Never use a local ephemeral DB on serverless.
ALLOW_LOCAL_DB=true
# PostgreSQL via Supabase PostgREST (run scripts/schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
